# FinAudit AI Configuration

# Storage location for local database and caches
FINAUDIT_DATA_DIR=data

# Primary LLM Configuration (Gemini or Ollama)
LLM_PRIMARY=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=768

# Optional fallback provider configuration
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=90
GEMINI_API_KEY=

# OpenAI-compatible providers remain supported
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
